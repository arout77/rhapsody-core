<h3>The share form</h3>
<p>Two details matter here. <code>csrf_field()</code> adds the hidden token that the global middleware checks, and <code>enctype="multipart/form-data"</code> is required for the file input.</p>
<p class="text-sm font-mono text-gray-500 dark:text-gray-400 mb-1">views/recipes/create.twig</p>
<pre><code class="language-twig">&#123;% extends "layouts/main.twig" %&#125;

&#123;% block content %&#125;
&lt;div class="max-w-2xl mx-auto"&gt;
    &lt;h1 class="text-3xl font-bold mb-6"&gt;Share a recipe&lt;/h1&gt;

    &lt;form method="post" action="&#123;{ route('recipes.store') &#125;&#125;" enctype="multipart/form-data" class="space-y-5"&gt;
        &#123;{ csrf_field() &#125;&#125;

        &lt;div&gt;
            &lt;label for="title" class="block font-bold mb-1"&gt;Title&lt;/label&gt;
            &lt;input id="title" name="title" type="text" maxlength="160" required value="&#123;{ old.title|default('') &#125;&#125;"
                   class="w-full rounded border border-gray-300 dark:border-gray-600 dark:bg-gray-900 p-2"&gt;
            &#123;% if errors.title %&#125;&lt;p class="text-red-600 text-sm mt-1"&gt;&#123;{ errors.title|first &#125;&#125;&lt;/p&gt;&#123;% endif %&#125;
        &lt;/div&gt;

        &lt;div&gt;
            &lt;label for="summary" class="block font-bold mb-1"&gt;One-line summary&lt;/label&gt;
            &lt;input id="summary" name="summary" type="text" maxlength="300" required value="&#123;{ old.summary|default('') &#125;&#125;"
                   class="w-full rounded border border-gray-300 dark:border-gray-600 dark:bg-gray-900 p-2"&gt;
            &#123;% if errors.summary %&#125;&lt;p class="text-red-600 text-sm mt-1"&gt;&#123;{ errors.summary|first &#125;&#125;&lt;/p&gt;&#123;% endif %&#125;
        &lt;/div&gt;

        &lt;div&gt;
            &lt;label for="servings" class="block font-bold mb-1"&gt;Servings&lt;/label&gt;
            &lt;input id="servings" name="servings" type="number" min="1" max="50" required value="&#123;{ old.servings|default(4) &#125;&#125;"
                   class="w-32 rounded border border-gray-300 dark:border-gray-600 dark:bg-gray-900 p-2"&gt;
            &#123;% if errors.servings %&#125;&lt;p class="text-red-600 text-sm mt-1"&gt;&#123;{ errors.servings|first &#125;&#125;&lt;/p&gt;&#123;% endif %&#125;
        &lt;/div&gt;

        &lt;div&gt;
            &lt;label for="ingredients" class="block font-bold mb-1"&gt;Ingredients &lt;span class="font-normal text-gray-500"&gt;(one per line, quantity first: "1 1/2 cups flour")&lt;/span&gt;&lt;/label&gt;
            &lt;textarea id="ingredients" name="ingredients" rows="6" required
                      class="w-full rounded border border-gray-300 dark:border-gray-600 dark:bg-gray-900 p-2"&gt;&#123;{ old.ingredients|default('') &#125;&#125;&lt;/textarea&gt;
            &#123;% if errors.ingredients %&#125;&lt;p class="text-red-600 text-sm mt-1"&gt;&#123;{ errors.ingredients|first &#125;&#125;&lt;/p&gt;&#123;% endif %&#125;
        &lt;/div&gt;

        &lt;div&gt;
            &lt;label for="steps" class="block font-bold mb-1"&gt;Method &lt;span class="font-normal text-gray-500"&gt;(one step per line)&lt;/span&gt;&lt;/label&gt;
            &lt;textarea id="steps" name="steps" rows="6" required
                      class="w-full rounded border border-gray-300 dark:border-gray-600 dark:bg-gray-900 p-2"&gt;&#123;{ old.steps|default('') &#125;&#125;&lt;/textarea&gt;
            &#123;% if errors.steps %&#125;&lt;p class="text-red-600 text-sm mt-1"&gt;&#123;{ errors.steps|first &#125;&#125;&lt;/p&gt;&#123;% endif %&#125;
        &lt;/div&gt;

        &lt;div&gt;
            &lt;label for="photo" class="block font-bold mb-1"&gt;Photo &lt;span class="font-normal text-gray-500"&gt;(JPG, PNG, GIF or WebP, up to 4 MB)&lt;/span&gt;&lt;/label&gt;
            &lt;input id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/gif,image/webp"&gt;
            &#123;% if errors.photo %&#125;&lt;p class="text-red-600 text-sm mt-1"&gt;&#123;{ errors.photo|first &#125;&#125;&lt;/p&gt;&#123;% endif %&#125;
        &lt;/div&gt;

        &lt;button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded"&gt;Publish recipe&lt;/button&gt;
