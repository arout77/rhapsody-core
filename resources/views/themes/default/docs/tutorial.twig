<h2 id="react">Step 11: React Islands</h2>
<p>An island is a small React component dropped into an otherwise server-rendered page. Use one only where the page needs real interactivity: here, a favorite toggle and an ingredient list that rescales as you change the servings. The bridge from <code>react:install</code> finds every island and mounts it, and the theme layout already loads it.</p>
<pre><code class="language-bash">php rhapsody make:react FavoriteButton
php rhapsody make:react ServingScaler</code></pre>

<h3>The favorite button</h3>
<p class="text-sm font-mono text-gray-500 dark:text-gray-400 mb-1">resources/js/components/FavoriteButton.jsx</p>
<pre><code class="language-javascript">import React, { useState } from 'react';

export default function FavoriteButton({ endpoint, token, initial = false }) {
    const [favorite, setFavorite] = useState(initial);
    const [busy, setBusy] = useState(false);

    async function toggle() {
        setBusy(true);

        try {
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                // The CSRF middleware reads "_token" from the request body.
                body: JSON.stringify({ _token: token }),
            });

            if (!response.ok) {
                throw new Error(`Request failed with status ${response.status}`);
            }

            const data = await response.json();
            setFavorite(Boolean(data.favorite));
        } catch (error) {
            console.error('[FavoriteButton]', error);
        } finally {
            setBusy(false);
        }
    }

    return (
        &lt;button
            type="button"
            onClick={toggle}
            disabled={busy}
            aria-pressed={favorite}
            className="rounded border border-blue-500 px-4 py-2 font-bold text-blue-600 dark:text-blue-400 disabled:opacity-50"
        &gt;
            {favorite ? '♥ Saved' : '♡ Save'}
        &lt;/button&gt;
    );
}</code></pre>
<p>Two things to notice. First, the <code>Accept: application/json</code> header is what makes <code>wantsJson()</code> true in Step 6.5. Second, the token travels in the JSON body as <code>_token</code>, which is where the CSRF middleware looks for it.</p>

<h3>The serving scaler</h3>
<p class="text-sm font-mono text-gray-500 dark:text-gray-400 mb-1">resources/js/components/ServingScaler.jsx</p>
<pre><code class="language-javascript">import React, { useState } from 'react';

const QUANTITY = /^(\d+\s+\d+\/\d+|\d+\/\d+|\d+(?:\.\d+)?)(.*)$/;

function toNumber(raw) {
    const mixed = raw.match(/^(\d+)\s+(\d+)\/(\d+)$/);
    if (mixed) {
        return Number(mixed[1]) + Number(mixed[2]) / Number(mixed[3]);
    }

    const fraction = raw.match(/^(\d+)\/(\d+)$/);
    if (fraction) {
        return Number(fraction[1]) / Number(fraction[2]);
    }

    return Number(raw);
}

function scale(line, factor) {
    const match = line.match(QUANTITY);
    if (!match) {
        return line;
    }

    return `${Math.round(toNumber(match[1]) * factor * 100) / 100}${match[2]}`;
}

export default function ServingScaler({ baseServings, ingredients }) {
    const base = Number(baseServings) || 1;
    const [servings, setServings] = useState(base);
    const factor = servings / base;

    return (
        &lt;div&gt;
            &lt;div className="mb-3 flex items-center gap-3"&gt;
                &lt;button type="button" aria-label="Fewer servings"
                        onClick={() =&gt; setServings((n) =&gt; Math.max(1, n - 1))}
                        className="h-8 w-8 rounded border border-gray-400"&gt;-&lt;/button&gt;
                &lt;span aria-live="polite"&gt;{servings} {servings === 1 ? 'serving' : 'servings'}&lt;/span&gt;
                &lt;button type="button" aria-label="More servings"
                        onClick={() =&gt; setServings((n) =&gt; n + 1)}
                        className="h-8 w-8 rounded border border-gray-400"&gt;+&lt;/button&gt;
            &lt;/div&gt;

            &lt;ul className="list-disc pl-6 space-y-1"&gt;
                {ingredients.map((line, index) =&gt; (
                    &lt;li key={index}&gt;{scale(line, factor)}&lt;/li&gt;
                ))}
            &lt;/ul&gt;
        &lt;/div&gt;
    );
}</code></pre>

<h3>Run it</h3>
<pre><code class="language-bash"># Development: set VITE_DEV_SERVER=true in .env, then
npm run dev

# Production: set VITE_DEV_SERVER=false, then
npm run build</code></pre>
<p>Props travel from Twig to React as JSON in a non-executable <code>&lt;script&gt;</code> block, escaped so user text can never break out of it. Only pass the island what it needs: the CSRF token is fine because it only goes to the page that asked for it.</p>

