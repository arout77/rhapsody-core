{
  "name": "acme/welcome-bonus",
  "type": "rhapsody-module",
  "version": "1.0.0",
  "rhapsody_core": "^2.0",
  "title": "Welcome Bonus",
  "description": "Grants new users a configurable welcome bonus and lets them check their balance.",
  "category": "commerce",
  "license": "proprietary",
  "author": {
    "name": "Acme Modules",
    "email": "hello@acme.example"
  },
  "provider": "Acme\\WelcomeBonus\\ModuleProvider",
  "permissions": {
    "events.listen": {
      "listen": ["Rhapsody\\Core\\Events\\UserRegistered"]
    },
    "routes.register": {
      "prefix": "welcome-bonus"
    },
    "settings.manage": {},
    "storage.access": {}
  },
  "settings_schema": [
    { "key": "bonus_amount", "type": "number", "label": "Bonus amount (USD)", "default": 10 }
  ]
}
