{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rhapsody-framework.com/schema/module.schema.json",
  "title": "Rhapsody Module Manifest",
  "description": "Every capability a module can request is declared here. ModuleContext refuses anything not granted in this file, which is what lets the marketplace validate a module's attack surface before running a single line of its code.",
  "type": "object",
  "required": ["name", "type", "version", "rhapsody_core", "title", "provider"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9\\-]+/[a-z0-9\\-]+$",
      "description": "vendor-slug/module-slug — must match the Composer package name"
    },
    "type": {
      "const": "rhapsody-module",
      "description": "Composer package type used for marketplace/registry discovery"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[\\w.]+)?$"
    },
    "rhapsody_core": {
      "type": "string",
      "description": "Semver constraint against rhapsody-core, e.g. \"^2.0\""
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "category": {
      "type": "string",
      "enum": ["seo", "commerce", "content", "analytics", "integration", "security", "media", "utility", "other"]
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier or \"proprietary\""
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "provider": {
      "type": "string",
      "description": "Fully-qualified class name implementing Rhapsody\\Core\\Modules\\Contracts\\ModuleServiceProviderInterface"
    },
    "permissions": {
      "type": "object",
      "description": "Closed set of capability keys. Anything not listed here is not requestable — see ModuleManifest::CAPABILITIES.",
      "additionalProperties": false,
      "properties": {
        "events.listen": {
          "type": "object",
          "required": ["listen"],
          "additionalProperties": false,
          "properties": {
            "listen": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" },
              "description": "Explicit whitelist of fully-qualified event class names — no wildcard grants"
            }
          }
        },
        "routes.register": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "string",
              "pattern": "^[a-z0-9\\-]+$",
              "description": "Namespaced routes are mounted at /{prefix}/... ; defaults to the module slug. No literal 'modules' segment is forced."
            },
            "paths": {
              "type": "array",
              "items": { "type": "string", "pattern": "^/[a-z0-9\\-/._]+$" },
              "description": "Explicit whitelist of exact root-level paths (e.g. \"/sitemap.xml\") this module may register with no prefix, via RoutesFacade::root()"
            }
          }
        },
        "twig.extensions": { "type": "object", "additionalProperties": false },
        "twig.functions": { "type": "object", "additionalProperties": false },
        "storage.access": { "type": "object", "additionalProperties": false },
        "settings.manage": { "type": "object", "additionalProperties": false }
      }
    },
    "settings_schema": {
      "type": "array",
      "description": "Drives an auto-generated admin settings form for this module",
      "items": {
        "type": "object",
        "required": ["key", "type", "label"],
        "properties": {
          "key": { "type": "string" },
          "type": { "type": "string", "enum": ["string", "number", "boolean", "select"] },
          "label": { "type": "string" },
          "default": {},
          "options": { "type": "array" }
        }
      }
    }
  }
}
